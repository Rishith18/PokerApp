# Supabase PostgreSQL connection string (required for auth and match stats)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT secret for session tokens (required for auth). Generate with: openssl rand -hex 32
# JWT_SECRET=your-secret-here

# Optional: JWT expiration in hours (default 24)
# JWT_EXPIRATION_HOURS=24
